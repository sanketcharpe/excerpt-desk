{
  "name": "Excerpt Desk",
  "short_name": "Excerpt Desk",
  "description": "PDF reading, excerpts and notes of argument, synced with Google Drive.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#e6eaf0",
  "theme_color": "#2c49c9",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "file_handlers": [
    {"action": "./", "accept": {"application/pdf": [".pdf"], "image/jpeg": [".jpg", ".jpeg"], "image/png": [".png"]}, "launch_type": "single-client"}
  ],
  "launch_handler": {"client_mode": "focus-existing"},
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {"title": "title", "text": "text", "files": [{"name": "files", "accept": ["application/pdf", ".pdf", "image/jpeg", "image/png", ".jpg", ".jpeg", ".png"]}]}
  }
}
